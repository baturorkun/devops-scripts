
oc new-project ${GUID}-cicd --display-name="My CICD Project"

oc new-app jenkins-persistent --param MEMORY_LIMIT=2Gi --param DISABLE_ADMINISTRATIVE_MONITORS=true --param ENABLE_OAUTH=true --as-deployment-config=true
oc set resources dc jenkins --limits=cpu=2 --requests=cpu=1,memory=2Gi
Watch the pods deploy:


oc get route jenkins -o jsonpath='{.spec.host}{"\n"}'